# ============================================================
# Antigravity CRM - Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to Git
# ============================================================

# --- Server ---
HOST=0.0.0.0
PORT=8009
ENV=development
ALLOWED_ORIGINS=http://localhost:8009,http://127.0.0.1:8009,http://localhost:8001,http://127.0.0.1:8001

# --- Database ---
DB_PATH=./crm.db

# --- Security ---
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS
TOKEN_EXPIRE_MINUTES=1440
SESSION_COOKIE_NAME=session_token
AUTH_DISABLED=false
COOKIE_SECURE=true
API_DOCS_ENABLED=false

# --- AI Providers ---
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- M365 Integration ---
M365_ENABLED=false
M365_CLIENT_ID=
M365_TENANT_ID=
M365_CLIENT_SECRET=
M365_SCOPES=openid profile offline_access User.Read Mail.Read Mail.ReadWrite Mail.Send Calendars.Read Calendars.ReadWrite
M365_AUTH_REDIRECT_URI=https://your-domain.com/api/auth/microsoft/callback
M365_SYNC_INTERVAL_SECONDS=300

# --- Uploads ---
UPLOADS_DIR=./uploads
MAX_UPLOAD_MB=50

# --- Backups ---
BACKUP_DIR=./backups
BACKUP_EXTERNAL_DIR=./backups_external
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=3
BACKUP_SCHEDULE_HOUR=3
BACKUP_SCHEDULE_MINUTE=0
BACKUP_TIMEZONE=UTC

# --- Briefing Labels ---
BRIEF_TTS_VOICE=nova
BRIEF_LABEL_RECRUITMENT=Recruitment & Talent
BRIEF_LABEL_OBE=OBE Focus

REL_INTEL_USE_LLM=true
REL_INTEL_LENS_USE_LLM=true
